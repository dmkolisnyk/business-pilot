# Application

NODE_ENV=development

# API

API_PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database

DATABASE_URL=postgresql://business_pilot:business_pilot_password@localhost:5434/business_pilot?schema=public

# Redis / Queue

REDIS_URL=redis://localhost:6380

# Security

# Required: generate a secret containing at least 32 random bytes.
JWT_SECRET=
APP_ENCRYPTION_KEY=change-me-32-bytes-minimum
WOOCOMMERCE_WEBHOOK_SECRET=change-me

# AI Provider

OPENAI_API_KEY=

# Email Provider

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=[no-reply@businesspilot.local](mailto:no-reply@businesspilot.local)
