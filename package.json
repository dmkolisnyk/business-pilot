{
  "name": "business-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Business Pilot monorepo for WooCommerce-first ecommerce analytics SaaS.",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/web --filter ./apps/api dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter ./apps/web build",
    "build:api": "pnpm --filter ./apps/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter ./apps/api test:e2e --runInBand",
    "audit:deps": "pnpm audit --audit-level moderate",
    "agents:validate": "node scripts/agents/validate.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:reset": "docker compose down -v --remove-orphans"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.11.0"
  },
  "packageManager": "pnpm@11.11.0",
  "license": "MIT"
}
