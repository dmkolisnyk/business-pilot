# PostgreSQL

POSTGRES_USER=business_pilot
POSTGRES_PASSWORD=business_pilot_password
POSTGRES_DB=business_pilot

# Published host ports

POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# Public application URLs

NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Security

# Required outside the Docker Compose local fallback: use at least 32 random bytes.
JWT_SECRET=
APP_ENCRYPTION_KEY=change-me-32-bytes-minimum
WOOCOMMERCE_WEBHOOK_SECRET=change-me-for-local-docker

# AI Provider

OPENAI_API_KEY=

# Email Provider

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@businesspilot.local
